{
  "name": "tps-system",
  "version": "1.0.0-dev",
  "private": true,
  "description": "Local-only Training Planning & Scheduling application",
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node --env-file=.env dist/src/api/server.js",
    "start:legacy": "node dist/src/server.js",
    "dev": "tsx watch --env-file=.env src/api/server.ts",
    "demo": "npm run build && node dist/src/demo.js",
    "check": "npm test",
    "import:csv": "npm run build && node dist/src/import-cli.js",
    "solver:build": "cd solver && mvn -B -ntp clean package",
    "db:migrate": "npm run build && node --env-file=.env dist/src/api/migrate.js",
    "db:seed": "npm run build && node --env-file=.env dist/src/api/seed.js",
    "db:check": "npm run build && node --env-file=.env dist/src/api/check.js",
    "db:bootstrap": "npm run build && node --env-file=.env dist/src/api/bootstrap.js",
    "db:backup": "node --env-file=.env scripts/backup-restore.mjs backup",
    "db:backup:verify": "node --env-file=.env scripts/backup-restore.mjs verify",
    "db:restore:test": "node --env-file=.env scripts/backup-restore.mjs restore-test",
    "local:production:init": "node --env-file=.env scripts/local-production.mjs init",
    "local:production:check": "node --env-file=.env scripts/local-production.mjs check",
    "local:production:bootstrap": "node --env-file=.env scripts/local-production.mjs bootstrap",
    "local:production:start": "node --env-file=.env scripts/local-production.mjs start",
    "web:install": "cd frontend && npm ci",
    "web:build": "npm run build --prefix frontend",
    "e2e": "npm run e2e --prefix frontend"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.5.1",
    "argon2": "0.44.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  },
  "license": "UNLICENSED"
}
